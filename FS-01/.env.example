# ==============================================================================
# SyncSpace — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# IMPORTANT: Never commit your real `.env` or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Runtime
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PostgreSQL Database & Prisma ORM
# ------------------------------------------------------------------------------
# Connection string with connection pooling (e.g. Neon Serverless / Supabase / local)
DATABASE_URL="postgresql://username:password@ep-example.region.neon.tech/syncspace?sslmode=require"

# Direct unpooled connection string (required by Prisma for schema migrations and advisory locks)
DIRECT_URL="postgresql://username:password@ep-example-direct.region.neon.tech/syncspace?sslmode=require"

# Optional query logging (set to "true" for debugging)
DEBUG_PRISMA="false"

# ------------------------------------------------------------------------------
# Better Auth (Authentication & Session Security)
# ------------------------------------------------------------------------------
# 32+ character random secret used to sign session cookies and tokens
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-random-secret-key-goes-here"
BETTER_AUTH_URL="http://localhost:3000"

# Optional alias compatibility
AUTH_SECRET="your-32-character-random-secret-key-goes-here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Real-Time WebSocket Collaboration Server (y-websocket)
# ------------------------------------------------------------------------------
# Client-facing WebSocket URL
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Collaboration server bind configuration
COLLAB_HOST="0.0.0.0"
COLLAB_PORT=1234

# Secret for HMAC-SHA256 signing of collaboration room access tokens
COLLAB_SECRET="your-32-character-collab-token-secret-goes-here"

# ------------------------------------------------------------------------------
# Distributed Scaling & Redis Pub/Sub (Multi-Server Coordination)
# ------------------------------------------------------------------------------
# Redis connection URL (local Docker or managed cloud provider such as Upstash)
# Format: redis://[:password@]host:port or rediss:// for TLS
REDIS_URL="redis://localhost:6379"

# Set to "false" to run collaboration in standalone single-server mode
REDIS_ENABLED="true"

# Key prefix for distributed pub/sub channels and persistence flush locks
REDIS_KEY_PREFIX="syncspace:collab:"
